# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interactive_course

# For Docker: DATABASE_URL is set in docker-compose.yml automatically

# ===========================================
# LLM Configuration (LiteLLM format)
# ===========================================

# --- Option A: Ollama (local, free) ---
LLM_MODEL=ollama/llama3
LLM_API_BASE=http://localhost:11434

# --- Option B: Groq (fast, free tier) ---
# LLM_MODEL=groq/llama-3.1-70b-versatile
# LLM_API_KEY=your-groq-api-key

# --- Option C: Cohere ---
# LLM_MODEL=cohere/command-r-plus
# LLM_API_KEY=your-cohere-api-key

# --- Option D: OpenAI ---
# LLM_MODEL=gpt-4o
# LLM_API_KEY=your-openai-api-key

# --- Option E: Anthropic ---
# LLM_MODEL=anthropic/claude-3-sonnet-20240229
# LLM_API_KEY=your-anthropic-api-key

# ===========================================
# LLM Hardening
# ===========================================
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5

# ===========================================
# App
# ===========================================
UPLOAD_DIR=./uploads
DEBUG=false

# ===========================================
# Docker-specific (used by docker-compose)
# ===========================================
POSTGRES_PASSWORD=postgres
LLM_MODEL_NAME=llama3
